{
  "manifest_version": 3,
  "name": "TypeShift",
  "version": "1.3.0",
  "description": "Cleanly shift the typography of any website while protecting native icon fonts.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "typeshift@jbuilds.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
